<nav class="navbar navbar-default">
  <div class="mainMenu-container">

    <!-- extra start -->
    <div class="cinema-logo">
      <a onClick="Actions.Router.gotoRoute('{{route}}')" href="#{{route}}" >
        <img class="cinema-logo" src="images/logo.svg">
      </a>
    </div>
    <!-- extra end -->
<div class="docmenu">
  <ul class="nav navbar-nav mainMenu">
  {{#each view.mainMenu}}
      <li class="{{#if isActive}}active{{/if}} {{#unless isAvailable}}disabled{{/unless}}">
        <a  onClick="Actions.Router.gotoRoute('{{route}}')" action="{{route}}" class="routes navbar-right {{route}}" href="#{{route}}">
          {{{label}}}
        </a>
      </li>
  {{/each}}
  </ul>
</div>
</div>
<div class="list_container">
  <ol class="hidden-sm-down nav navbar-nav evaluation-menu">
    {{#each view.evalMenu}}
      <li class="{{#if isActive}}active{{/if}} {{#unless isAvailable}}disabled{{/unless}}">
        <a  onClick="Actions.Router.gotoRoute('{{route}}')" action="{{route}}" class="routes navbar-right {{route}}" href="#{{route}}">
          {{{label}}}
        </a>
      </li>
    {{/each}}
  </ol>
</div>
</nav>
{{#if banner.hasProject}}
<div class="project-banner">
  <div class="project-banner-inner">
    <i class="fa fa-file-text-o" aria-hidden="true"></i>
    <span class="project-banner-title">{{banner.projectTitle}}</span>
    {{#if banner.format}}
    <span class="project-banner-meta">{{banner.type}} &middot; {{banner.format}}</span>
    {{/if}}
    <!-- unsaved indicator removed — auto-saves to collection on every persist -->
    <!-- {{#if banner.hasUnsavedChanges}}
    <span class="project-banner-unsaved">
      <i class="fa fa-circle" aria-hidden="true"></i> unsaved
    </span>
    {{/if}} -->
    {{#if banner.fromCollection}}
    <span class="project-banner-collection">
      <i class="fa fa-folder-open-o" aria-hidden="true"></i> {{banner.collectionTitle}}
    </span>
    {{/if}}
  </div>
</div>
{{/if}}
<div class="visible-print">
  <h2>
    Confidence In Network Meta Analysis - CINeMA 2.0.0 - Project: 
    <b>
      {{view.title}}
    </b>
  </h2>
</div>
