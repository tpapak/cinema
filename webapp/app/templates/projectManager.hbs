<!-- projectManager.hbs — Single-collection model -->
<!-- Old multi-collection template replaced; see git history for previous version -->
<div class="container-fluid routed" id="project-manager">
  <div class="col-xs-12 col-md-offset-1 col-md-10">

    <h2>Projects</h2>
    <p class="comments">
      Manage your projects. A collection (<em>.cdb</em>) contains
      one or more CINeMA projects. A project (<em>.cnm</em>) is a single-project file.
    </p>

    <!-- Top toolbar: only visible when no collection is loaded -->
    {{#unless view.hasCollection}}
    <div class="pm-toolbar">
      <button onClick="Actions.ProjectManager.newCollection()"
              class="btn btn-primary btn-sm">
        <i class="fa fa-plus" aria-hidden="true"></i> New Collection
      </button>
      <span class="pm-upload-wrap">
        <label for="pmUploadCollection" class="btn btn-default btn-sm">
          <i class="fa fa-upload" aria-hidden="true"></i> Upload Collection (.cdb)
        </label>
        <input type="file" id="pmUploadCollection" accept=".cdb,.CDB,.json,.JSON"
               style="display:none" />
      </span>
    </div>
    {{/unless}}

    {{#unless view.hasCollection}}
    <div class="pm-empty">
      <p>No collection loaded. Create a new one or upload a <em>.cdb</em> collection.</p>
    </div>
    {{/unless}}

    {{#if view.hasCollection}}
    <!-- Active collection panel -->
    <div class="pm-collections">
      <div class="pm-collection panel panel-primary">
        <div class="panel-heading pm-collection-header">
          <h4 class="panel-title pm-collection-title">
            <i class="fa fa-folder-open" aria-hidden="true"></i>
            {{view.collection.title}}
            <span class="badge">{{view.collection.projects.length}} projects</span>
          </h4>
          <div class="pm-collection-actions">
            <button onClick="Actions.ProjectManager.renameCollection()"
                    class="btn btn-xs btn-default" title="Rename collection">
              <i class="fa fa-pencil" aria-hidden="true"></i>
            </button>
            <button onClick="Actions.ProjectManager.exportCollection()"
                    class="btn btn-xs btn-default" title="Export as .cdb">
              <i class="fa fa-download" aria-hidden="true"></i>
            </button>
            <button onClick="Actions.ProjectManager.clearCollection()"
                    class="btn btn-xs btn-danger" title="Remove collection">
              <i class="fa fa-trash" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="panel-body">
          {{#if view.collection.description}}
          <p class="text-muted">{{view.collection.description}}</p>
          {{/if}}

          <!-- Project toolbar: inside collection -->
          <div class="pm-project-toolbar">
            <!-- "New Project" removed: empty projects are useless without data -->
            <!-- Use "Upload Project (.cnm)" or "Upload Dataset (.csv)" instead -->
            <span class="pm-upload-wrap">
              <label for="pmUploadProject" class="btn btn-default btn-sm">
                <i class="fa fa-upload" aria-hidden="true"></i> Upload Project (.cnm)
              </label>
              <input type="file" id="pmUploadProject" accept=".cnm,.CNM,.json,.JSON"
                     style="display:none" />
            </span>
            <span class="pm-upload-wrap">
              <label for="pmUploadCSV" class="btn btn-default btn-sm">
                <i class="fa fa-upload" aria-hidden="true"></i> Upload Dataset (.csv)
              </label>
              <input type="file" id="pmUploadCSV" accept=".csv,.CSV"
                     style="display:none" />
            </span>
          </div>

          {{#unless view.collection.projects.length}}
          <p class="text-muted pm-empty-projects">
            No projects in this collection. Create one, upload a <em>.cnm</em>
            project, or upload a <em>.csv</em> dataset.
          </p>
          {{/unless}}

          {{#if view.projectsView.length}}
          <table class="table table-hover pm-project-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Outcome</th>
                <th>Studies</th>
                <th>Analyzed</th>
                <th>Evaluated</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each view.projectsView}}
              <tr class="pm-project-row {{#if isActive}}pm-project-active{{/if}}">
                <td>
                  <strong>{{title}}</strong>
                  {{#if isActive}}
                  <span class="label label-primary pm-active-badge">active</span>
                  <!-- unsaved badge removed — auto-saves to collection on every persist -->
                  {{/if}}
                  {{#if description}}
                  <br><small class="text-muted">{{description}}</small>
                  {{/if}}
                </td>
                <td>
                  {{#if outcome}}{{outcome}}{{else}}<em class="text-muted">--</em>{{/if}}
                  <button onClick="Actions.ProjectManager.editOutcome('{{id}}')"
                          class="btn btn-xs btn-link" title="Edit outcome">
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                  </button>
                </td>
                <td>
                  {{#if hasStudies}}
                    {{studyCount}} arms
                  {{else}}
                    --
                  {{/if}}
                </td>
                <td>
                  {{#if isAnalyzed}}
                    <i class="fa fa-check text-success" aria-hidden="true"></i>
                  {{else}}
                    <i class="fa fa-minus text-muted" aria-hidden="true"></i>
                  {{/if}}
                </td>
                <td>
                  {{#if hasEvaluation}}
                    <i class="fa fa-check text-success" aria-hidden="true"></i>
                  {{else}}
                    <i class="fa fa-minus text-muted" aria-hidden="true"></i>
                  {{/if}}
                </td>
                <td class="pm-project-actions">
                  <button onClick="Actions.ProjectManager.openProject('{{id}}')"
                          class="btn btn-xs btn-primary" title="Open in CINeMA">
                    <i class="fa fa-folder-open" aria-hidden="true"></i> Open
                  </button>
                  <button onClick="Actions.ProjectManager.renameProject('{{id}}')"
                          class="btn btn-xs btn-default" title="Rename">
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                  </button>
                  <button onClick="Actions.ProjectManager.exportProject('{{id}}')"
                          class="btn btn-xs btn-default" title="Export as .cnm">
                    <i class="fa fa-download" aria-hidden="true"></i>
                  </button>
                  <button onClick="Actions.ProjectManager.removeProject('{{id}}')"
                          class="btn btn-xs btn-danger" title="Remove">
                    <i class="fa fa-trash" aria-hidden="true"></i>
                  </button>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
          {{/if}}
        </div>
      </div>
    </div>
    {{/if}}

    <!-- Save progress button removed — auto-saves to collection on every persist -->
    <!-- {{#if view.hasActiveProject}}
    <div class="pm-save-back {{#if view.hasUnsavedChanges}}pm-save-back-unsaved{{/if}}">
      {{#if view.hasUnsavedChanges}}
      <p class="pm-unsaved-notice">
        <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
        You have unsaved changes. Save progress to keep your work in the collection.
      </p>
      {{/if}}
      <button onClick="Actions.ProjectManager.saveBackToCollection()"
              class="btn btn-success">
        <i class="fa fa-save" aria-hidden="true"></i> Save progress back to collection
      </button>
    </div>
    {{/if}} -->

    <hr>
    <button onClick="Actions.Project.resetApp()"
            class="btn btn-danger btn-sm">
      <i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Reset CINeMA
    </button>

  </div>
</div>
