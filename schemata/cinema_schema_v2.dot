digraph CinemaSchemaV2 {
    rankdir=TB;
    node [shape=plaintext, fontname="Helvetica", fontsize=11];
    edge [color="#64748b", arrowsize=0.7, fontname="Helvetica", fontsize=10];
    graph [fontname="Helvetica", fontsize=12,
           label="CINeMA Exchange Schema v2\n\nSolid edge = required child  |  Dashed edge = optional child\nRed field = required  |  Gray field = optional  |  Amber = conditional",
           labelloc=t, labeljust=c, pad="0.5"];

    // =====================================================
    // PROJECT (root)
    // =====================================================
    project [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#334155">
        <TR><TD COLSPAN="3" BGCOLOR="#334155"><FONT COLOR="white"><B>project</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>format</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7c3aed">"long"|"wide"|"iv"</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>type</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7c3aed">"binary"|"continuous"</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // STUDY ARM
    // =====================================================
    studyArm [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#059669">
        <TR><TD COLSPAN="3" BGCOLOR="#059669"><FONT COLOR="white"><B>studyArm</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>study</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string|int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">"ALLHAT" or 1</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string|int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">study identifier</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>treatment</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string|int</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">"ACE" or 1 (PS: TreatmentId)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>n</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer &gt;= 1</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">sample size</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>rob</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer 1|2|3</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">1=Low 2=Some 3=High</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>indirectness</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer 1|2|3</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">1=Low 2=Mod 3=High</FONT></TD></TR>
        <TR><TD COLSPAN="3" BGCOLOR="#f3f4f6"><FONT COLOR="#6b7280"><I>oneOf binary / continuous:</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#f59e0b"><B>events</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#f59e0b">binary only</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#f59e0b"><B>mean</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#f59e0b">continuous only</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#f59e0b"><B>sd</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt; 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#f59e0b">continuous only</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // ANALYSIS (compact hub -- no field listing, just a label)
    // =====================================================
    analysis [label=<
        <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#7c3aed">
        <TR><TD BGCOLOR="#7c3aed"><FONT COLOR="white"><B>analysis</B></FONT></TD></TR>
        <TR><TD><FONT COLOR="#6b7280">one per model / sm / framework<BR/>cache key: (model, sm, framework, tau)</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // ANALYSIS PARAMS
    // =====================================================
    analysisParams [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#a78bfa">
        <TR><TD COLSPAN="3" BGCOLOR="#a78bfa"><FONT COLOR="white"><B>params</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>model</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7c3aed">"fixed"|"random"</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>sm</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7c3aed">"OR"|"RR"|"RD"|"MD"|"SMD"</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">framework</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7c3aed">"frequentist"|"bayesian"</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">tau</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">heterogeneity SD</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">label</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">human-readable name</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // HAT MATRIX
    // =====================================================
    hatMatrix [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#0891b2">
        <TR><TD COLSPAN="3" BGCOLOR="#0891b2"><FONT COLOR="white"><B>hatMatrix</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>H</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number[][]</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">rows=all comps, cols=direct</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>rowNames</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">comparisonId[]</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">all network comparisons</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>colNames</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">comparisonId[]</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">direct comparisons only</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // COMPARISON RESULT
    // =====================================================
    comparisonResult [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#dc2626">
        <TR><TD COLSPAN="3" BGCOLOR="#dc2626"><FONT COLOR="white"><B>comparisonResult</B>  (one per network comparison)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>comparison</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">comparisonId</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">"ACE:BBlocker"</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>effect</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">NMA pooled (log for ratios)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>se</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">standard error</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>ciLower, ciUpper</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">95% confidence interval</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>priLower, priUpper</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">95% prediction interval</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>propDirect</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number 0..1</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">proportion direct evidence</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // DIRECT ESTIMATE
    // =====================================================
    directEstimate [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fef2f2" COLOR="#059669">
        <TR><TD COLSPAN="2" BGCOLOR="#059669"><FONT COLOR="white"><B>direct</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>effect</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>ciLower</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>ciUpper</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // INDIRECT ESTIMATE
    // =====================================================
    indirectEstimate [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eff6ff" COLOR="#2563eb">
        <TR><TD COLSPAN="2" BGCOLOR="#2563eb"><FONT COLOR="white"><B>indirect</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>effect</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>ciLower</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>ciUpper</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // SIDE TEST (incoherence)
    // =====================================================
    sideTest [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fdf4ff" COLOR="#9333ea">
        <TR><TD COLSPAN="3" BGCOLOR="#9333ea"><FONT COLOR="white"><B>incoherence</B>  (requires direct+indirect)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>effect</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">incoherence factor</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>ciLower, ciUpper</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>z</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">Z statistic</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>pvalue</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number 0..1</FONT></TD><TD></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // PAIRWISE RESULT
    // =====================================================
    pairwiseResult [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#f59e0b">
        <TR><TD COLSPAN="3" BGCOLOR="#f59e0b"><FONT COLOR="white"><B>pairwiseResult</B>  (one per direct comparison)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>comparison</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">comparisonId</FONT></TD><TD></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>tau2</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">between-study variance</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>I2</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number 0..1</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">I-squared</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">I2Lower, I2Upper</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // NETWORK HETEROGENEITY
    // =====================================================
    networkHeterogeneity [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#fbbf24">
        <TR><TD COLSPAN="3" BGCOLOR="#fbbf24"><FONT COLOR="white"><B>networkHeterogeneity</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>tau2</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">network tau-squared</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">Qoverall</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">Qheterogeneity</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">Qinconsistency</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number</FONT></TD><TD></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // DESIGN BY TREATMENT
    // =====================================================
    designByTreatment [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#8b5cf6">
        <TR><TD COLSPAN="3" BGCOLOR="#8b5cf6"><FONT COLOR="white"><B>designByTreatment</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>Q</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">Q statistic</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>df</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number &gt;= 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">degrees of freedom</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#dc2626"><B>pvalue</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">number 0..1</FONT></TD><TD></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // STUDY CONTRIBUTIONS
    // =====================================================
    studyContributions [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#16a34a">
        <TR><TD BGCOLOR="#16a34a"><FONT COLOR="white"><B>studyContributions</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#6b7280">map&lt;comparisonId, map&lt;studyId, %&gt;&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">e.g. {"ACE:ARB": {"ALLHAT": 14.5, "1": 0.4}}</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">values = % contribution (sum ~ 100)</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // LEAGUE TABLE
    // =====================================================
    leagueTable [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#94a3b8"><FONT COLOR="white"><B>leagueTable</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string[][] (square matrix)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">diagonal = names, off-diag = "1.23 (0.56, 2.34)"</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // SENSITIVITY LEAGUE TABLES
    // =====================================================
    sensitivityLT [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#94a3b8"><FONT COLOR="white"><B>sensitivityLeagueTables</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">lowRoB</FONT>  <FONT COLOR="#6b7280">string[][]</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">lowModerateRoB</FONT>  <FONT COLOR="#6b7280">string[][]</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // SHARED TYPES (at the bottom)
    // =====================================================
    comparisonId [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc" COLOR="#94a3b8" STYLE="dashed">
        <TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#374151"><B>comparisonId</B>  (type)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#6b7280">string: ^[a-zA-Z0-9_]+:[a-zA-Z0-9_]+$</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">e.g. "ACE:BBlocker", "1:2"</FONT></TD></TR>
        </TABLE>
    >];

    stringOrInt [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8fafc" COLOR="#94a3b8" STYLE="dashed">
        <TR><TD BGCOLOR="#e2e8f0"><FONT COLOR="#374151"><B>stringOrInteger</B>  (type)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#6b7280">oneOf: string | integer</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#9ca3af">PS: TreatmentId = StringId String | IntId Int</FONT></TD></TR>
        </TABLE>
    >];

    // =====================================================
    // EDGES -- each child appears exactly once
    // =====================================================

    // project -> its two children
    project -> studyArm [label="  studies[]  ", fontcolor="#1e293b", penwidth=1.5];
    project -> analysis [label="  analyses[]  ", fontcolor="#1e293b", penwidth=1.5];

    // analysis -> required children (solid)
    analysis -> analysisParams [label="  params  ", fontcolor="#1e293b", penwidth=1.5];
    analysis -> comparisonResult [label="  nmaResults[]  ", fontcolor="#1e293b", penwidth=1.5];
    analysis -> studyContributions [label="  studyContributions\n  [RoB][Indirectness]  ", fontcolor="#1e293b", penwidth=1.5];

    // analysis -> optional children (dashed)
    analysis -> hatMatrix [label="  hatMatrix  ", style=dashed, fontcolor="#9ca3af"];
    analysis -> pairwiseResult [label="  pairwise[]  \n  [Heterogeneity]  ", style=dashed, fontcolor="#9ca3af"];
    analysis -> networkHeterogeneity [label="  networkHeterogeneity  \n  [Heterogeneity]  ", style=dashed, fontcolor="#9ca3af"];
    analysis -> designByTreatment [label="  designByTreatment  \n  [Incoherence]  ", style=dashed, fontcolor="#9ca3af"];
    analysis -> leagueTable [label="  leagueTable  ", style=dashed, fontcolor="#9ca3af"];
    analysis -> sensitivityLT [label="  sensitivityLeagueTables  ", style=dashed, fontcolor="#9ca3af"];

    // comparisonResult -> optional sub-objects (dashed)
    comparisonResult -> directEstimate [label="  direct  ", style=dashed, fontcolor="#9ca3af"];
    comparisonResult -> indirectEstimate [label="  indirect  ", style=dashed, fontcolor="#9ca3af"];
    comparisonResult -> sideTest [label="  incoherence  \n  [Incoherence domain]  ", style=dashed, fontcolor="#9ca3af"];

    // type references (dotted, no constraint so they float to the side)
    studyArm -> stringOrInt [style=dotted, color="#cbd5e1", arrowhead=empty, constraint=false, label="  uses  ", fontcolor="#cbd5e1", fontsize=9];
    comparisonResult -> comparisonId [style=dotted, color="#cbd5e1", arrowhead=empty, constraint=false, label="  uses  ", fontcolor="#cbd5e1", fontsize=9];

    // =====================================================
    // LAYOUT
    // =====================================================
    { rank=same; studyArm; analysis; }
    { rank=same; directEstimate; indirectEstimate; sideTest; }
    { rank=same; comparisonId; stringOrInt; }
}
